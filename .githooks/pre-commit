#!/bin/sh
# Poyi pre-commit 一致性审计 (verifier)
# 对应 claude-obsidian 的 verifier sub-agent / PostToolUse hook 能力。
# Poyi 此前在「神经系统」维度为真空白（审计 2026-06-30 标记 Hooks=无、Sub Agent=0）。
#
# 作用：提交前自动跑 Loom/scripts/verifier.py，阻断 BLOCKER 级不一致
#      （规格声明 AGENTS.md / INDEX.md 与磁盘物理不符）。
# 紧急跳过（不推荐）：git commit --no-verify

ROOT=$(git rev-parse --show-toplevel)
VERIFIER="$ROOT/Loom/scripts/verifier.py"

# hooksPath 自检：本 hook 被触发的前提是 core.hooksPath 正确指向 .githooks。
# 双机 clone 后若未执行 `git config core.hooksPath .githooks`，本脚本不会被调用，
# 但以防有人手动拷贝 hook 到 .git/hooks 绕过配置，此处仍做兜底断言。
CURRENT_HOOKS_PATH=$(git config --get core.hooksPath || true)
if [ "$CURRENT_HOOKS_PATH" != ".githooks" ]; then
  echo "❌ core.hooksPath 未配置为 .githooks（当前: ${CURRENT_HOOKS_PATH:-<未设置>}）。"
  echo "   请执行: git config core.hooksPath .githooks"
  exit 1
fi

if [ -f "$VERIFIER" ]; then
  # Windows 上 python3 往往是微软商店的假别名：command -v 能找到但跑不动，
  # 所以必须真跑一次才认。verifier 输出含 emoji，GBK 控制台需强制 UTF-8。
  PY=""
  for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c "pass" >/dev/null 2>&1; then PY="$c"; break; fi
  done
  if [ -z "$PY" ]; then
    echo "❌ 未找到可用的 python 解释器（python3/python/py），无法运行 verifier。"
    exit 1
  fi
  if ! PYTHONIOENCODING=utf-8 "$PY" "$VERIFIER"; then
    echo ""
    echo "❌ pre-commit 校验未通过：存在 BLOCKER 级不一致，提交已阻断。"
    echo "   请修复上方 🔴 条目后重新 git add + commit。"
    echo "   紧急跳过（不推荐）: git commit --no-verify"
    exit 1
  fi
fi
exit 0
